{
  "manifest_version": 3,
  "name": "Stream Rating Overlay",
  "version": "1.3.0",
  "description": "在 Netflix 與 Disney+ 片名旁顯示 IMDb、Rotten Tomatoes、Metacritic 與 TMDB 評分，並可依清單或分數過濾",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://www.netflix.com/*",
    "https://www.disneyplus.com/*",
    "https://www.omdbapi.com/*",
    "https://www.imdb.com/*",
    "https://letterboxd.com/*",
    "https://api.themoviedb.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.netflix.com/*",
        "https://www.disneyplus.com/*"
      ],
      "js": ["content.js"],
      "css": ["ratings.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Stream Rating Overlay",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
